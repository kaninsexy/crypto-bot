# ─────────────────────────────────────────────────────────────────────────────
# .env.example — Copy to .env and fill in your values.
# NEVER commit .env to git — it contains secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Binance credentials ───────────────────────────────────────────────────────
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ── OKX credentials (paper mode: not required) ───────────────────────────────
OKX_API_KEY=your_okx_api_key_here
OKX_API_SECRET=your_okx_api_secret_here
OKX_PASSPHRASE=your_okx_passphrase_here

# ── Trading mode ──────────────────────────────────────────────────────────────
# "paper" = simulate trades. "live" = real orders. Start with paper always.
TRADING_MODE=paper

TRADING_PAIR=BTC/USDT
TIMEFRAME=1h
PAPER_BALANCE=10000.0

# ── Per-strategy symbol assignment ───────────────────────────────────────────
# SYMBOL_DCA=BTC/USDT
# SYMBOL_SUPERTREND=ETH/USDT
# SYMBOL_MEANREV=LINK/USDT
# SYMBOL_GRID=SOL/USDT
# SYMBOL_BREAKOUT=AVAX/USDT
# SYMBOL_TREND=BTC/USDT
# SYMBOL_BEARSHORT=BTC/USDT
# SYMBOL_VWAP=ETH/USDT

# ── Risk management ───────────────────────────────────────────────────────────
MAX_RISK_PER_TRADE=0.02
STOP_LOSS_PCT=0.03
TAKE_PROFIT_PCT=0.06
DAILY_LOSS_LIMIT_PCT=5.0

# ── Telegram notifications ────────────────────────────────────────────────────
# Setup: message @BotFather on Telegram → /newbot → get BOT_TOKEN
# Find CHAT_ID: https://api.telegram.org/bot<BOT_TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Exchange reconciliation (live mode only) ──────────────────────────────────
# After restart, bot compares checkpoint positions vs live Binance Futures.
# RECONCILE_AUTO_CLOSE_GHOST: true = auto-close unknown exchange positions.
# Default is false (log CRITICAL only, manual action required).
RECONCILE_AUTO_CLOSE_GHOST=false
RECONCILE_TIMEOUT_SECONDS=15

LOG_LEVEL=INFO
