{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "agent_frontmatter.schema.json",
  "title": "Agent frontmatter contract — siamese-reconcile",
  "description": "Every .claude/agents/*.md file carries this YAML frontmatter as its canonical contract. The body is the prompt; if they conflict, fix the body. Lint with scripts/validate_agent_frontmatter.py (plain python3 — needs PyYAML, present in the pyenv interpreter; the uv env deliberately carries no yaml dependency). Adapted from the playbooks template (port V2, BK-0012).",
  "type": "object",
  "required": ["name", "model", "tools", "agent_id", "version", "model_rationale"],
  "properties": {
    "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "description": {"type": "string"},
    "parent": {"type": "array", "items": {"type": "string"}},
    "model": {"enum": ["haiku", "sonnet", "opus"]},
    "tools": {"type": ["string", "array"]},
    "permissionMode": {"type": "string"},
    "maxTurns": {"type": "integer", "minimum": 1},
    "memory": {"type": "string"},
    "hooks": {"type": "object"},
    "agent_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "version": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[0-9]+$"},
    "model_rationale": {"type": "string", "minLength": 10},
    "status": {"enum": ["active", "disabled"]},
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "mode"],
        "properties": {
          "path": {"type": "string"},
          "mode": {"enum": ["read", "write", "append"]},
          "cache": {"enum": ["per_invocation", "per_day", "per_week", "never"]},
          "required": {"type": "boolean"}
        }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "mode"],
        "properties": {
          "path": {"type": "string"},
          "mode": {"enum": ["write", "append"]},
          "schema": {"type": ["string", "null"]},
          "validate_before_write": {"type": "boolean"}
        }
      }
    },
    "prerequisites": {"type": "array"},
    "cost_guardrails": {
      "type": "object",
      "properties": {
        "max_input_tokens": {"type": "integer"},
        "max_output_tokens": {"type": "integer"},
        "hard_timeout_seconds": {"type": "integer"}
      }
    },
    "retry_policy": {"type": "object"},
    "cache_strategy": {"type": "object"},
    "anti_fabrication": {"type": "array", "items": {"type": "string"}},
    "modes": {"type": "object"}
  },
  "additionalProperties": true
}
