# Tier-1 fixtures: path-allowlist.py Bash dispatch — the write-target scan.
# PROOF (ii) of the S1 VERIFY block: `echo x > CLAUDE.md` in a Bash call is
# BLOCKED. The archived sacred-block.sh never looked at Bash at all, so a
# redirect was a complete bypass of the sacred gate even when jq WAS present.
{"desc": "PROOF-ii: block `echo x > CLAUDE.md` (bash redirect onto a sacred path)", "hook": "path-allowlist.py", "eval_type": "checkpoint", "payload": {"tool_name": "Bash", "tool_input": {"command": "echo x > CLAUDE.md"}, "session_id": "tier1"}, "expect_exit": 2, "expect_stderr_contains": "BLOCKED"}
{"desc": "block append redirect onto backtest/trials.log (tripwire 1 at the tool layer)", "hook": "path-allowlist.py", "eval_type": "checkpoint", "payload": {"tool_name": "Bash", "tool_input": {"command": "echo row >> backtest/trials.log"}, "session_id": "tier1"}, "expect_exit": 2}
{"desc": "block tee onto docs/MASTER_PLAN.md", "hook": "path-allowlist.py", "eval_type": "checkpoint", "payload": {"tool_name": "Bash", "tool_input": {"command": "cat body | tee docs/MASTER_PLAN.md"}, "session_id": "tier1"}, "expect_exit": 2}
{"desc": "block sed -i on a sacred file", "hook": "path-allowlist.py", "eval_type": "checkpoint", "payload": {"tool_name": "Bash", "tool_input": {"command": "sed -i 's/a/b/' CLAUDE.md"}, "session_id": "tier1"}, "expect_exit": 2}
{"desc": "block rm of a sacred file (delete is a Tier-1 write)", "hook": "path-allowlist.py", "eval_type": "checkpoint", "payload": {"tool_name": "Bash", "tool_input": {"command": "rm backtest/holdout_access.log"}, "session_id": "tier1"}, "expect_exit": 2}
{"desc": "block cp onto a sacred destination", "hook": "path-allowlist.py", "eval_type": "checkpoint", "payload": {"tool_name": "Bash", "tool_input": {"command": "cp /tmp/x backtest/holdout_manifest.json"}, "session_id": "tier1"}, "expect_exit": 2}
{"desc": "block mv onto a sacred destination", "hook": "path-allowlist.py", "eval_type": "checkpoint", "payload": {"tool_name": "Bash", "tool_input": {"command": "mv /tmp/x .claude/settings.json"}, "session_id": "tier1"}, "expect_exit": 2}
{"desc": "block python open(...,'w') on a sacred file", "hook": "path-allowlist.py", "eval_type": "checkpoint", "payload": {"tool_name": "Bash", "tool_input": {"command": "python -c \"open('backtest/trials.log','a').write('x')\""}, "session_id": "tier1"}, "expect_exit": 2}
{"desc": "block a sacred write buried in a chain", "hook": "path-allowlist.py", "eval_type": "checkpoint", "payload": {"tool_name": "Bash", "tool_input": {"command": "python -m pytest -q && echo done > CLAUDE.md && git status"}, "session_id": "tier1"}, "expect_exit": 2}
{"desc": "read-shaped bash command is allowed", "hook": "path-allowlist.py", "eval_type": "checkpoint", "payload": {"tool_name": "Bash", "tool_input": {"command": "git log --oneline -20"}, "session_id": "tier1"}, "expect_exit": 0}
{"desc": "redirect to a Tier-3 path is allowed", "hook": "path-allowlist.py", "eval_type": "checkpoint", "payload": {"tool_name": "Bash", "tool_input": {"command": "python scripts/recon_binance_um.py > docs/megaloop_status_2026-09.md"}, "session_id": "tier1"}, "expect_exit": 0}
{"desc": "variable-expanded target is skipped (unknowable at hook time)", "hook": "path-allowlist.py", "eval_type": "checkpoint", "payload": {"tool_name": "Bash", "tool_input": {"command": "echo x > $OUT"}, "session_id": "tier1"}, "expect_exit": 0}
{"desc": "a commented-out command is not scanned", "hook": "path-allowlist.py", "eval_type": "checkpoint", "payload": {"tool_name": "Bash", "tool_input": {"command": "# echo x > CLAUDE.md"}, "session_id": "tier1"}, "expect_exit": 0}
{"desc": "override authorises a bash write to a sacred path too", "hook": "path-allowlist.py", "eval_type": "checkpoint", "payload": {"tool_name": "Bash", "tool_input": {"command": "echo x > CLAUDE.md"}, "session_id": "tier1"}, "env": {"SACRED_OVERRIDE_FILES": "CLAUDE.md"}, "expect_exit": 0}
