# Tier-1 fixtures: the observational hooks. These WRITE, so every one runs
# against a sandbox CLAUDE_PROJECT_DIR and asserts the artifact appeared.
{"desc": "session-end writes a T1 episode + index", "hook": "session-end.py", "eval_type": "checkpoint", "payload": {"session_id": "tier1", "agent_type": "main", "tool_uses": [{"tool": "Write", "input": {"file_path": "CLAUDE.md"}}]}, "sandbox_project_dir": true, "expect_exit": 0, "expect_write_glob": ".memory/T1_episodic/episodes/*/session_end_*.json"}
{"desc": "pre-compact writes a state snapshot", "hook": "pre-compact.py", "eval_type": "checkpoint", "payload": {"session_id": "tier1", "trigger": "auto"}, "sandbox_project_dir": true, "expect_exit": 0, "expect_write_glob": ".memory/T1_episodic/_state/precompact_*.md", "expect_stdout_contains": "State snapshot saved"}
{"desc": "observe records a PreToolUse Bash call without echoing the command", "hook": "observe.py", "eval_type": "checkpoint", "payload": {"hook_event_name": "PreToolUse", "session_id": "tier1", "tool_name": "Bash", "tool_input": {"command": "cat ~/.crypto-bot.env"}}, "sandbox_project_dir": true, "env": {"OBSERVATION_DIR": ""}, "expect_exit": 0}
{"desc": "session-start loads T2 facts and the open backlog from a synthetic tree", "hook": "session-start.py", "eval_type": "checkpoint", "payload": {"session_id": "tier1"}, "sandbox_project_dir": true, "sandbox_seed": {".memory/T2_semantic/facts.md": "- paper_mode is the default.\n", ".memory/T2_semantic/backlog.jsonl": "{\"id\": \"BK-0001\", \"status\": \"open\", \"title\": \"six kept bash hooks still need jq\", \"severity\": \"medium\", \"owner\": \"cc\", \"created_at\": \"2026-09-02\"}\n"}, "expect_exit": 0, "expect_stdout_contains": ["Live facts", "BK-0001"]}
{"desc": "session-start stays silent on a fresh tree with nothing to load", "hook": "session-start.py", "eval_type": "checkpoint", "payload": {"session_id": "tier1"}, "sandbox_project_dir": true, "expect_exit": 0}
{"desc": "SESSION_START_CONTEXT=off disables the loader", "hook": "session-start.py", "eval_type": "checkpoint", "payload": {"session_id": "tier1"}, "sandbox_project_dir": true, "sandbox_seed": {".memory/T2_semantic/facts.md": "- a fact.\n"}, "env": {"SESSION_START_CONTEXT": "off"}, "expect_exit": 0}
{"desc": "post-commit-sync is inert when the command is not a git commit", "hook": "post-commit-sync.py", "eval_type": "checkpoint", "payload": {"tool_name": "Bash", "tool_input": {"command": "git status"}, "tool_response": {"stdout": "", "stderr": "", "interrupted": false}, "session_id": "tier1"}, "sandbox_project_dir": true, "expect_exit": 0}
