# Tier-1 fixtures: commit-guard.py — mandate G (shape) + mandate H (content).
# Merged from the archived commit-heredoc-required.sh + commit-format.sh, both
# of which failed open (jq absent) on every call.
{"desc": "block `git commit -m` with no heredoc (mandate G shape)", "hook": "commit-guard.py", "eval_type": "checkpoint", "payload": {"tool_name": "Bash", "tool_input": {"command": "git commit -m \"fix: something\""}, "session_id": "tier1"}, "expect_exit": 2, "expect_stderr_contains": "heredoc-embedded"}
{"desc": "allow the canonical `git commit -F - <<'EOF'` form", "hook": "commit-guard.py", "eval_type": "checkpoint", "payload": {"tool_name": "Bash", "tool_input": {"command": "git commit -F - <<'EOF'\ngovernance(S1.2): port the python hook layer\n\nBody explaining the change.\n\n[mandate-H]\nCo-authored-by: Claude <noreply@anthropic.com>\nEOF"}, "session_id": "tier1"}, "expect_exit": 0}
{"desc": "allow the `-m \"$(cat <<'EOF' ... EOF)\"` form (has -m AND a heredoc)", "hook": "commit-guard.py", "eval_type": "checkpoint", "payload": {"tool_name": "Bash", "tool_input": {"command": "git commit -m \"$(cat <<'EOF'\nchore(hooks): tidy\n\nbody\nEOF\n)\""}, "session_id": "tier1"}, "expect_exit": 0}
{"desc": "block a non-conventional subject", "hook": "commit-guard.py", "eval_type": "checkpoint", "payload": {"tool_name": "Bash", "tool_input": {"command": "git commit -F - <<'EOF'\nported the hooks\n\nbody\nEOF"}, "session_id": "tier1"}, "expect_exit": 2, "expect_stderr_contains": "conventional format"}
{"desc": "block an agent commit missing the [mandate-H] token", "hook": "commit-guard.py", "eval_type": "checkpoint", "payload": {"tool_name": "Bash", "tool_input": {"command": "git commit -F - <<'EOF'\nfix(hooks): tidy\n\nbody\n\nCo-authored-by: Claude <noreply@anthropic.com>\nEOF"}, "session_id": "tier1"}, "expect_exit": 2, "expect_stderr_contains": "mandate-H"}
{"desc": "a HUMAN commit (no Co-authored-by trailer) needs no [mandate-H]", "hook": "commit-guard.py", "eval_type": "checkpoint", "payload": {"tool_name": "Bash", "tool_input": {"command": "git commit -F - <<'EOF'\nfix(hooks): tidy\n\nbody\nEOF"}, "session_id": "tier1"}, "expect_exit": 0}
{"desc": "crypto-bot subject types are accepted (trials:)", "hook": "commit-guard.py", "eval_type": "checkpoint", "payload": {"tool_name": "Bash", "tool_input": {"command": "git commit -F - <<'EOF'\ntrials: FundingDispersionCarry v1 retire\n\nbody\nEOF"}, "session_id": "tier1"}, "expect_exit": 0}
{"desc": "crypto-bot subject types are accepted (discovery:)", "hook": "commit-guard.py", "eval_type": "checkpoint", "payload": {"tool_name": "Bash", "tool_input": {"command": "git commit -F - <<'EOF'\ndiscovery: Phase 4.F kill-test results\n\nbody\nEOF"}, "session_id": "tier1"}, "expect_exit": 0}
{"desc": "`git commit --amend` is passed through untouched", "hook": "commit-guard.py", "eval_type": "checkpoint", "payload": {"tool_name": "Bash", "tool_input": {"command": "git commit --amend --no-edit"}, "session_id": "tier1"}, "expect_exit": 0}
{"desc": "an editor commit (no -m, no heredoc) is left to .githooks/commit-msg", "hook": "commit-guard.py", "eval_type": "checkpoint", "payload": {"tool_name": "Bash", "tool_input": {"command": "git commit"}, "session_id": "tier1"}, "expect_exit": 0}
{"desc": "a non-commit command is ignored", "hook": "commit-guard.py", "eval_type": "checkpoint", "payload": {"tool_name": "Bash", "tool_input": {"command": "git log --grep commit -5"}, "session_id": "tier1"}, "expect_exit": 0}
