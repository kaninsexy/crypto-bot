# Tier-1 fixtures: SACRED_OVERRIDE_FILES scope semantics (crypto-bot).
#
# PROOF (i-b): a Write to CLAUDE.md is ALLOWED when the override names it.
# PROOF (iv): the harness STRIPS an ambient SACRED_OVERRIDE_FILES inherited
#             from the launching shell, so a block-fixture cannot be silently
#             flipped to allow by the very env var this megaloop was launched
#             with. The block fixtures in path-allowlist-write-edit.jsonl set
#             no "env" key at all; if the harness leaked the ambient value they
#             would all go GREEN-but-wrong. The pair below is the discriminating
#             check: identical payload, one with an explicit env, one without.
{"desc": "PROOF-i-b: allow Write to CLAUDE.md when the override names it exactly", "hook": "path-allowlist.py", "eval_type": "checkpoint", "payload": {"tool_name": "Write", "tool_input": {"file_path": "CLAUDE.md"}, "session_id": "tier1"}, "env": {"SACRED_OVERRIDE_FILES": "CLAUDE.md"}, "expect_exit": 0, "expect_stderr_contains": "SACRED OVERRIDE"}
{"desc": "PROOF-iv: same payload with NO fixture env is still BLOCKED (ambient override is stripped by the harness)", "hook": "path-allowlist.py", "eval_type": "checkpoint", "payload": {"tool_name": "Write", "tool_input": {"file_path": "CLAUDE.md"}, "session_id": "tier1"}, "expect_exit": 2, "expect_stderr_contains": "BLOCKED"}
{"desc": "override of a DIFFERENT sacred file does not authorise CLAUDE.md", "hook": "path-allowlist.py", "eval_type": "checkpoint", "payload": {"tool_name": "Write", "tool_input": {"file_path": "CLAUDE.md"}, "session_id": "tier1"}, "env": {"SACRED_OVERRIDE_FILES": "docs/MASTER_PLAN.md"}, "expect_exit": 2}
{"desc": "comma-separated list: second entry authorises", "hook": "path-allowlist.py", "eval_type": "checkpoint", "payload": {"tool_name": "Write", "tool_input": {"file_path": "docs/MASTER_PLAN.md"}, "session_id": "tier1"}, "env": {"SACRED_OVERRIDE_FILES": "CLAUDE.md,docs/MASTER_PLAN.md"}, "expect_exit": 0, "expect_stderr_contains": "SACRED OVERRIDE"}
{"desc": "explicit trailing-slash directory scope authorises beneath it", "hook": "path-allowlist.py", "eval_type": "checkpoint", "payload": {"tool_name": "Write", "tool_input": {"file_path": ".claude/rules/escalation.md"}, "session_id": "tier1"}, "env": {"SACRED_OVERRIDE_FILES": ".claude/rules/"}, "expect_exit": 0, "expect_stderr_contains": "SACRED OVERRIDE"}
{"desc": "crypto-bot adaptation: an entry NAMING AN EXISTING DIRECTORY is a directory scope (this is how the megaloop launch line writes .claude/hooks)", "hook": "path-allowlist.py", "eval_type": "checkpoint", "payload": {"tool_name": "Write", "tool_input": {"file_path": ".claude/hooks/path-allowlist.py"}, "session_id": "tier1"}, "env": {"SACRED_OVERRIDE_FILES": ".claude/hooks"}, "expect_exit": 0, "expect_stderr_contains": "SACRED OVERRIDE"}
{"desc": "BK-0304 stays fixed: a NON-directory bystander entry containing '.env' as a substring does NOT authorise .env", "hook": "path-allowlist.py", "eval_type": "checkpoint", "payload": {"tool_name": "Write", "tool_input": {"file_path": ".env"}, "session_id": "tier1"}, "env": {"SACRED_OVERRIDE_FILES": "docs/.environment_notes.md"}, "expect_exit": 2, "expect_stderr_contains": "BLOCKED"}
{"desc": "a bare '/' whole-repo scope is dropped, never honoured", "hook": "path-allowlist.py", "eval_type": "checkpoint", "payload": {"tool_name": "Write", "tool_input": {"file_path": "CLAUDE.md"}, "session_id": "tier1"}, "env": {"SACRED_OVERRIDE_FILES": "/"}, "expect_exit": 2}
{"desc": "empty override string authorises nothing", "hook": "path-allowlist.py", "eval_type": "checkpoint", "payload": {"tool_name": "Write", "tool_input": {"file_path": "CLAUDE.md"}, "session_id": "tier1"}, "env": {"SACRED_OVERRIDE_FILES": ""}, "expect_exit": 2}
{"desc": "the block message echoes the PARSED scope, so a wrong delimiter is visible", "hook": "path-allowlist.py", "eval_type": "checkpoint", "payload": {"tool_name": "Write", "tool_input": {"file_path": "CLAUDE.md"}, "session_id": "tier1"}, "env": {"SACRED_OVERRIDE_FILES": "CLAUDE.md docs/MASTER_PLAN.md"}, "expect_exit": 2, "expect_stderr_contains": "Authorized this session"}
