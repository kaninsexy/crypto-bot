# Tier-1 fixtures: provenance-guard.py — the origin x domain gate.
# Orthogonal to the tier gate: even a NON-sacred file is off-limits to an
# autonomous background write unless the background loop authored it.
{"desc": "foreground origin (env unset) is a pure no-op", "hook": "provenance-guard.py", "eval_type": "checkpoint", "payload": {"tool_name": "Write", "tool_input": {"file_path": ".memory/T2_semantic/facts.md"}, "session_id": "tier1"}, "expect_exit": 0}
{"desc": "explicit foreground origin is a no-op", "hook": "provenance-guard.py", "eval_type": "checkpoint", "payload": {"tool_name": "Write", "tool_input": {"file_path": ".memory/T2_semantic/facts.md"}, "session_id": "tier1"}, "env": {"CLAUDE_WRITE_ORIGIN": "foreground"}, "expect_exit": 0}
{"desc": "background may write the pending-review queue it authors", "hook": "provenance-guard.py", "eval_type": "checkpoint", "payload": {"tool_name": "Write", "tool_input": {"file_path": ".memory/T2_semantic/_pending_review.jsonl"}, "session_id": "tier1"}, "env": {"CLAUDE_WRITE_ORIGIN": "background_review"}, "expect_exit": 0}
{"desc": "background may write the pending-review DIRECTORY (crypto-bot layout)", "hook": "provenance-guard.py", "eval_type": "checkpoint", "payload": {"tool_name": "Write", "tool_input": {"file_path": ".memory/T2_semantic/_pending_review/citations/x.md"}, "session_id": "tier1"}, "env": {"CLAUDE_WRITE_ORIGIN": "background_review"}, "expect_exit": 0}
{"desc": "background may write a discovery ledger row", "hook": "provenance-guard.py", "eval_type": "checkpoint", "payload": {"tool_name": "Write", "tool_input": {"file_path": "research/discovery/perp-structural.md"}, "session_id": "tier1"}, "env": {"CLAUDE_WRITE_ORIGIN": "background_review"}, "expect_exit": 0}
{"desc": "background may NOT write human-authored facts.md", "hook": "provenance-guard.py", "eval_type": "checkpoint", "payload": {"tool_name": "Write", "tool_input": {"file_path": ".memory/T2_semantic/facts.md"}, "session_id": "tier1"}, "env": {"CLAUDE_WRITE_ORIGIN": "background_review"}, "expect_exit": 2, "expect_stderr_contains": "BLOCKED"}
{"desc": "background may NOT write code", "hook": "provenance-guard.py", "eval_type": "checkpoint", "payload": {"tool_name": "Write", "tool_input": {"file_path": "backtest/engine_cs.py"}, "session_id": "tier1"}, "env": {"CLAUDE_WRITE_ORIGIN": "background_review"}, "expect_exit": 2}
{"desc": "path traversal cannot masquerade as an agent-authored path", "hook": "provenance-guard.py", "eval_type": "checkpoint", "payload": {"tool_name": "Write", "tool_input": {"file_path": ".memory/T2_semantic/citations/../facts.md"}, "session_id": "tier1"}, "env": {"CLAUDE_WRITE_ORIGIN": "background_review"}, "expect_exit": 2}
{"desc": "background Bash write to a human-authored path is blocked", "hook": "provenance-guard.py", "eval_type": "checkpoint", "payload": {"tool_name": "Bash", "tool_input": {"command": "echo x > .memory/T2_semantic/facts.md"}, "session_id": "tier1"}, "env": {"CLAUDE_WRITE_ORIGIN": "background_review"}, "expect_exit": 2}
{"desc": "background Bash write with a variable target fails CLOSED", "hook": "provenance-guard.py", "eval_type": "checkpoint", "payload": {"tool_name": "Bash", "tool_input": {"command": "echo x > $TARGET"}, "session_id": "tier1"}, "env": {"CLAUDE_WRITE_ORIGIN": "background_review"}, "expect_exit": 2}
{"desc": "background origin with a malformed payload fails CLOSED", "hook": "provenance-guard.py", "eval_type": "checkpoint", "payload_raw": "{not json", "env": {"CLAUDE_WRITE_ORIGIN": "background_review"}, "expect_exit": 2}
{"desc": "case variation cannot silently disable the guard", "hook": "provenance-guard.py", "eval_type": "checkpoint", "payload": {"tool_name": "Write", "tool_input": {"file_path": ".memory/T2_semantic/facts.md"}, "session_id": "tier1"}, "env": {"CLAUDE_WRITE_ORIGIN": "Background_Review"}, "expect_exit": 2}
