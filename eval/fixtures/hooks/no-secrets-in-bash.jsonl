# Tier-1 fixtures: no-secrets-in-bash.py.
# PROOF (iii) of the S1 VERIFY block: `cat ~/.crypto-bot.env` is BLOCKED.
# The archived bash version could not block anything at all — it shelled out to
# jq, which is absent, so it exited 127 (non-blocking) on every call.
{"desc": "PROOF-iii: block `cat ~/.crypto-bot.env`", "hook": "no-secrets-in-bash.py", "eval_type": "checkpoint", "payload": {"tool_name": "Bash", "tool_input": {"command": "cat ~/.crypto-bot.env"}, "session_id": "tier1"}, "expect_exit": 2, "expect_stderr_contains": "BLOCKED"}
{"desc": "block `cat .env`", "hook": "no-secrets-in-bash.py", "eval_type": "checkpoint", "payload": {"tool_name": "Bash", "tool_input": {"command": "cat .env"}, "session_id": "tier1"}, "expect_exit": 2}
{"desc": "block a literal Anthropic key", "hook": "no-secrets-in-bash.py", "eval_type": "checkpoint", "payload": {"tool_name": "Bash", "tool_input": {"command": "curl -H 'x-api-key: sk-ant-api03-AAAAAAAAAAAAAAAAAAAAAAAAAA' https://api.anthropic.com"}, "session_id": "tier1"}, "expect_exit": 2}
{"desc": "block a literal OpenRouter key", "hook": "no-secrets-in-bash.py", "eval_type": "checkpoint", "payload": {"tool_name": "Bash", "tool_input": {"command": "export KEY=sk-or-v1-AAAAAAAAAAAAAAAAAAAAAAAAAA"}, "session_id": "tier1"}, "expect_exit": 2}
{"desc": "block a literal Google key", "hook": "no-secrets-in-bash.py", "eval_type": "checkpoint", "payload": {"tool_name": "Bash", "tool_input": {"command": "echo AIzaSyAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"}, "session_id": "tier1"}, "expect_exit": 2}
{"desc": "block a PEM private-key fragment", "hook": "no-secrets-in-bash.py", "eval_type": "checkpoint", "payload": {"tool_name": "Bash", "tool_input": {"command": "echo '-----BEGIN RSA PRIVATE KEY-----'"}, "session_id": "tier1"}, "expect_exit": 2}
{"desc": "block printenv of a secret env var", "hook": "no-secrets-in-bash.py", "eval_type": "checkpoint", "payload": {"tool_name": "Bash", "tool_input": {"command": "printenv RESEND_API_KEY"}, "session_id": "tier1"}, "expect_exit": 2}
{"desc": "hook_secrets_scanner_false_positive: ${VAR} reference is ALLOWED", "hook": "no-secrets-in-bash.py", "eval_type": "checkpoint", "payload": {"tool_name": "Bash", "tool_input": {"command": "curl -H \"Authorization: Bearer ${RESEND_API_KEY}\" https://api.resend.com/emails"}, "session_id": "tier1"}, "expect_exit": 0}
