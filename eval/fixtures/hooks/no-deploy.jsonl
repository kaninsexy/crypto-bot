# Tier-1 fixtures: no-deploy.py — the live-venue and irreversible-git gate.
# The always-on set is safe to run on EVERY Bash call; the --strict set (ssh,
# bare `deploy`) stays agent-scoped because it false-blocks ordinary work.
{"desc": "block doctl", "hook": "no-deploy.py", "eval_type": "checkpoint", "payload": {"tool_name": "Bash", "tool_input": {"command": "doctl compute droplet list"}, "session_id": "tier1"}, "expect_exit": 2, "expect_stderr_contains": "BLOCKED"}
