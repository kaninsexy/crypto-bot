{"desc": "block branch deletion via push", "hook": "no-deploy.py", "eval_type": "checkpoint", "payload": {"tool_name": "Bash", "tool_input": {"command": "git push origin --delete feature/x"}, "session_id": "tier1"}, "expect_exit": 2}
