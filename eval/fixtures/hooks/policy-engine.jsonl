# Tier-1 fixtures: policy-engine.py adapter (the policy DSL gate).
# POLICY_ENGINE_POLICY_INLINE / _STATE_DIR keep each fixture hermetic — they
# never read the repo's real .claude/rules/policies/ nor its session state.
{"desc": "a block rule fires on the matching exec", "hook": "policy-engine.py", "eval_type": "checkpoint", "payload": {"hook_event_name": "PreToolUse", "tool_name": "Bash", "tool_input": {"command": "git commit -F - <<'EOF'\nchore: x\nEOF"}, "session_id": "tier1-pe-1"}, "env": {"POLICY_ENGINE_POLICY_INLINE": "rule no-commit:\n  block exec \"git\" \"commit\"\n  because \"test rule\"\n", "POLICY_ENGINE_STATE_DIR": "_tier1_pe_state_1"}, "expect_exit": 2, "expect_stderr_contains": "test rule"}
{"desc": "a non-matching exec passes", "hook": "policy-engine.py", "eval_type": "checkpoint", "payload": {"hook_event_name": "PreToolUse", "tool_name": "Bash", "tool_input": {"command": "git status --short"}, "session_id": "tier1-pe-2"}, "env": {"POLICY_ENGINE_POLICY_INLINE": "rule no-commit:\n  block exec \"git\" \"commit\"\n  because \"test rule\"\n", "POLICY_ENGINE_STATE_DIR": "_tier1_pe_state_2"}, "expect_exit": 0}
{"desc": "the ARG matches the subcommand position, so `git log --grep commit` does NOT false-block", "hook": "policy-engine.py", "eval_type": "checkpoint", "payload": {"hook_event_name": "PreToolUse", "tool_name": "Bash", "tool_input": {"command": "git log --grep commit -5"}, "session_id": "tier1-pe-3"}, "env": {"POLICY_ENGINE_POLICY_INLINE": "rule no-commit:\n  block exec \"git\" \"commit\"\n  because \"test rule\"\n", "POLICY_ENGINE_STATE_DIR": "_tier1_pe_state_3"}, "expect_exit": 0}
{"desc": "a notify rule is ADVISORY, never blocking", "hook": "policy-engine.py", "eval_type": "checkpoint", "payload": {"hook_event_name": "PreToolUse", "tool_name": "Write", "tool_input": {"file_path": "research/funding-dispersion-literature.md"}, "session_id": "tier1-pe-4"}, "env": {"POLICY_ENGINE_POLICY_INLINE": "rule lit:\n  notify write \"research/**\"\n  because \"pre-register first\"\n", "POLICY_ENGINE_STATE_DIR": "_tier1_pe_state_4"}, "expect_exit": 0, "expect_stderr_contains": "ADVISORY"}
{"desc": "a policy that fails to compile DISARMS the engine and surfaces loudly, but does NOT block", "hook": "policy-engine.py", "eval_type": "checkpoint", "payload": {"hook_event_name": "PreToolUse", "tool_name": "Bash", "tool_input": {"command": "git status"}, "session_id": "tier1-pe-5"}, "env": {"POLICY_ENGINE_POLICY_INLINE": "rule broken:\n  obliterate exec \"git\"\n", "POLICY_ENGINE_STATE_DIR": "_tier1_pe_state_5"}, "expect_exit": 0, "expect_stderr_contains": "POLICY_ENGINE_DISARMED"}
{"desc": "the off switch is honoured", "hook": "policy-engine.py", "eval_type": "checkpoint", "payload": {"hook_event_name": "PreToolUse", "tool_name": "Bash", "tool_input": {"command": "git commit -F - <<'EOF'\nchore: x\nEOF"}, "session_id": "tier1-pe-6"}, "env": {"POLICY_ENGINE_DISABLED": "1", "POLICY_ENGINE_POLICY_INLINE": "rule no-commit:\n  block exec \"git\" \"commit\"\n  because \"test rule\"\n", "POLICY_ENGINE_STATE_DIR": "_tier1_pe_state_6"}, "expect_exit": 0}
{"desc": "the shipped repo policy compiles (no DISARMED advisory on an ordinary call)", "hook": "policy-engine.py", "eval_type": "checkpoint", "payload": {"hook_event_name": "PreToolUse", "tool_name": "Bash", "tool_input": {"command": "git status --short"}, "session_id": "tier1-pe-7"}, "env": {"POLICY_ENGINE_STATE_DIR": "_tier1_pe_state_7"}, "expect_exit": 0}
