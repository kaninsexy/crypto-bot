# Tier-1 fixtures: the two agent-scoped guards (bound from .claude/agents/*.md
# frontmatter, never wired globally).
{"desc": "curator may write its one allowed path", "hook": "curator-write-allowlist.py", "eval_type": "checkpoint", "payload": {"tool_name": "Write", "tool_input": {"file_path": ".memory/T2_semantic/_pending_review.jsonl"}, "session_id": "tier1"}, "expect_exit": 0}
{"desc": "curator may write its own T1 episodes", "hook": "curator-write-allowlist.py", "eval_type": "checkpoint", "payload": {"tool_name": "Write", "tool_input": {"file_path": ".memory/T1_episodic/2026-09-02/note.md"}, "session_id": "tier1"}, "expect_exit": 0}
{"desc": "curator may NOT write facts.md directly (strategist review is the gate)", "hook": "curator-write-allowlist.py", "eval_type": "checkpoint", "payload": {"tool_name": "Write", "tool_input": {"file_path": ".memory/T2_semantic/facts.md"}, "session_id": "tier1"}, "expect_exit": 2, "expect_stderr_contains": "BLOCKED"}
{"desc": "curator may NOT write citations/ directly", "hook": "curator-write-allowlist.py", "eval_type": "checkpoint", "payload": {"tool_name": "Write", "tool_input": {"file_path": ".memory/T2_semantic/citations/x.md"}, "session_id": "tier1"}, "expect_exit": 2}
{"desc": "curator traversal out of the allowed path is blocked", "hook": "curator-write-allowlist.py", "eval_type": "checkpoint", "payload": {"tool_name": "Write", "tool_input": {"file_path": ".memory/T1_episodic/../T2_semantic/facts.md"}, "session_id": "tier1"}, "expect_exit": 2}
{"desc": "curator guard fails CLOSED on malformed stdin", "hook": "curator-write-allowlist.py", "eval_type": "checkpoint", "payload_raw": "{not json", "expect_exit": 2}
{"desc": "citation-required blocks WebSearch with no transcript (fail closed)", "hook": "citation-required.py", "eval_type": "checkpoint", "payload": {"tool_name": "WebSearch", "tool_input": {"query": "funding rate carry"}, "session_id": "tier1"}, "expect_exit": 2, "expect_stderr_contains": "BLOCKED"}
{"desc": "citation-required blocks a literature-file edit with no transcript", "hook": "citation-required.py", "eval_type": "checkpoint", "payload": {"tool_name": "Edit", "tool_input": {"file_path": "research/funding-dispersion-literature.md"}, "session_id": "tier1"}, "expect_exit": 2}
{"desc": "citation-required ignores an out-of-scope tool", "hook": "citation-required.py", "eval_type": "checkpoint", "payload": {"tool_name": "Bash", "tool_input": {"command": "git status"}, "session_id": "tier1"}, "expect_exit": 0}
{"desc": "citation-required ignores a non-literature file edit", "hook": "citation-required.py", "eval_type": "checkpoint", "payload": {"tool_name": "Edit", "tool_input": {"file_path": "docs/bot_status.md"}, "session_id": "tier1"}, "expect_exit": 0}
